# TRINETRA PSCD&L Backend Environment Configuration Example
# Copy to backend/.env for local overrides. Do NOT commit real secrets.

TRINETRA_APP_ENV=development
TRINETRA_HOST=127.0.0.1
TRINETRA_PORT=8000
TRINETRA_LOG_LEVEL=INFO

# CORS allowed origins (JSON array or comma-separated)
TRINETRA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# SQLite database URL (local default is backend/storage/trinetra.db)
# TRINETRA_DATABASE_URL=sqlite:///./backend/storage/trinetra.db

# Storage boundaries
# TRINETRA_STORAGE_ROOT=./backend/storage

# Upload and media validation limits
TRINETRA_MAX_UPLOAD_SIZE_BYTES=524288000
TRINETRA_ALLOWED_VIDEO_EXTENSIONS=[".avi",".mp4",".mov",".mkv"]
TRINETRA_MAX_VIDEO_DURATION_SECONDS=3600
TRINETRA_MAX_VIDEO_WIDTH=3840
TRINETRA_MAX_VIDEO_HEIGHT=2160
TRINETRA_MIN_FREE_DISK_BYTES=268435456

# Background worker & GPU safety (conservative defaults for 4 GB VRAM)
TRINETRA_WORKER_COUNT=1
TRINETRA_GPU_JOB_CONCURRENCY=1
TRINETRA_MAX_QUEUE_SIZE=20
TRINETRA_KEEP_MODEL_LOADED_ACROSS_JOBS=true

# Sampling interval bounds
TRINETRA_MIN_SAMPLING_INTERVAL_SECONDS=0.1
TRINETRA_MAX_SAMPLING_INTERVAL_SECONDS=60.0
