# TRINETRA PSCD&L Root Environment Example
# Copy values into backend/.env or frontend/.env as needed. Never commit real secrets.

TRINETRA_APP_ENV=development
TRINETRA_HOST=127.0.0.1
TRINETRA_PORT=8000
TRINETRA_LOG_LEVEL=INFO
TRINETRA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
TRINETRA_MAX_UPLOAD_SIZE_BYTES=524288000
TRINETRA_WORKER_COUNT=1
TRINETRA_GPU_JOB_CONCURRENCY=1
TRINETRA_MAX_QUEUE_SIZE=20
TRINETRA_KEEP_MODEL_LOADED_ACROSS_JOBS=true

# Optional frontend override (omit when using Vite dev proxy or Nginx reverse proxy)
# VITE_API_BASE_URL=http://127.0.0.1:8000
